# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# One Groq API key per analysis method — separate TPM buckets, true parallel execution.
# Get free keys at https://console.groq.com/keys
GROQ_MODEL=your-supported-model
GROQ_API_KEY1=gsk_xxxx   # analyze_repo
GROQ_API_KEY2=gsk_xxxx   # explain_architecture
GROQ_API_KEY3=gsk_xxxx   # generate_setup_guide
GROQ_API_KEY4=gsk_xxxx   # get_starter_tasks
GITHUB_TOKEN=ghp_xxxx

# Optional — adds Authorization header to GitHub API calls (raises rate limit from 60 to 5000 req/hr)
# Get a classic token with read:public_repo scope at https://github.com/settings/tokens

